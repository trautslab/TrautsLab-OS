# --- TELEGRAM BOT PUSH NOTIFICATIONS & VOICE BRIDGE ---
# 1. Obtén tu Bot Token hablando con @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN="TU_BOT_TOKEN_DE_TELEGRAM_AQUI"

# 2. Obtén tu Chat ID hablando con @userinfobot o @myidbot en Telegram (/start)
TELEGRAM_CHAT_ID="TU_CHAT_ID_DE_TELEGRAM_AQUI"

# 3. ID de usuario autorizado (generalmente el mismo que TELEGRAM_CHAT_ID)
TELEGRAM_ALLOWED_USER_ID="TU_CHAT_ID_DE_TELEGRAM_AQUI"

# --- OLLAMA LOCAL LLM ENGINE ---
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# --- OBSIDIAN VAULT PATH ---
OBSIDIAN_VAULT_ROOT="/Users/jlorenzor/Documents/Obsidian Vault"
