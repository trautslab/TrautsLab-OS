# TrautsLab OS .gitignore

# Dependencies
node_modules/
.pnpm-store/
vendor/

# Build and Temp outputs
dist/
build/
.cache/
*.tmp
*.log

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment and Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Local Data / Audio Cache (Large files)
/data/audio_cache/
/data/recordings/
/models/whisper/
/models/kokoro/

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
