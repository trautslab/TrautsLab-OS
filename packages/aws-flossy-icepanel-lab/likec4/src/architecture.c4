      technology 'AWS Lambda, Node.js'
    }

    sfn_fraud_suspicious_alert_investigation -> store_db_9 'accesses persistence'
    sfn_fraud_suspicious_alert_investigation -> eventbridge_bus 'subscribes to events from'
    plug_device_fingerprint_threatmetrix = plugApp 'plug-device-fingerprint-threatmetrix' {
      #squad #aws
      description 'Ingests device telemetry, IP reputation, and biometrics signals from LexisNexis/ThreatMetrix. js Lambda.'
      technology 'Node'
    }

    plug_device_fingerprint_threatmetrix -> store_db_9 'accesses persistence'
    plug_biocatch_behavioral_engine = plugApp 'plug-biocatch-behavioral-engine' {
      #squad #aws
      description 'Ingests mobile screen interaction dynamics and behavioral telemetry.'
      technology 'TypeScript Lambda'
    }

    plug_biocatch_behavioral_engine -> store_db_9 'accesses persistence'
    alm_fraud_high_risk_spike_alarm = alarmApp 'alm-fraud-high-risk-spike-alarm' {
      #squad #aws
      description 'Alarms on sudden surges of high-risk transactions in specific BIN or geography.'
      technology 'AWS Lambda, Node.js'
    }

    alm_fraud_high_risk_spike_alarm -> store_db_9 'accesses persistence'
  }

  dom_10 = domain 'SD-10: CUSTOMER ALERT & NOTIFICATION' {
    #bian
    description 'Multi-channel transactional alert dispatch (Push notifications, SMS, Email, WhatsApp) with preference routing and delivery tracking.'

    store_db_10 = datastore 'CUSTOMER ALERT & NOTIFICATION Storage' {
      #aws
      description 'Persistence and cache views for CUSTOMER ALERT & NOTIFICATION'
      technology 'Amazon DynamoDB & Redis'
    }

    cmd_customer_alert_dispatch = commandApp 'cmd-customer-alert-dispatch' {
