    sfn_financial_accounting_eod_reconciliation = sfnApp 'sfn-financial-accounting-eod-reconciliation' {
      #squad #aws
      description 'Step Function running at 23:59:00 to lock daily balances, reconcile with central ledger, and produce balance sheet vouchers.'
      technology 'AWS Lambda, Node.js'
    }

    sfn_financial_accounting_eod_reconciliation -> store_db_7 'accesses persistence'
