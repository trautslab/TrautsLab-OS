    }

    cmd_financial_accounting_voucher = commandApp 'cmd-financial-accounting-voucher' {
      #squad #aws
      description 'Creates double-entry debits and credits ledger vouchers.'
      technology 'TypeScript Lambda'
    }

    cmd_financial_accounting_voucher -> store_db_7 'accesses persistence'
    cmd_financial_accounting_voucher -> eventbridge_bus 'emits domain events to'
    qry_financial_accounting_trail = queryApp 'qry-financial-accounting-trail' {
