      technology 'Node'
    }

    cmd_customer_alert_dispatch -> store_db_10 'accesses persistence'
    cmd_customer_alert_dispatch -> eventbridge_bus 'emits domain events to'
    qry_customer_alert_delivery_status = queryApp 'qry-customer-alert-delivery-status' {
      #squad #aws
      description 'Inquires delivery status, open rates, and push delivery receipts.'
      technology 'TypeScript Lambda'
    }

    qry_customer_alert_delivery_status -> store_db_10 'accesses persistence'
    prj_customer_alert_audit_log = projectionApp 'prj-customer-alert-audit-log' {
      #squad #aws
      description 'Records notification compliance records (timestamp, recipient, payload hash).'
      technology 'Lambda'
    }

    prj_customer_alert_audit_log -> store_db_10 'accesses persistence'
    prj_customer_alert_audit_log -> eventbridge_bus 'subscribes to events from'
    plug_fcm_apns_push_gateway = plugApp 'plug-fcm-apns-push-gateway' {
      #squad #aws
      description 'Apple APNS & Google FCM mobile push connector.'
      technology 'Go Lambda'
    }

    plug_fcm_apns_push_gateway -> store_db_10 'accesses persistence'
    plug_twilio_infobip_sms_gateway = plugApp 'plug-twilio-infobip-sms-gateway' {
