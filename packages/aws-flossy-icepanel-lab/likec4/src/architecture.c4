}

views {
  view index {
    title 'Core Banking BIAN Architecture Landscape (11 Domains)'
    include *
  }

  view view_acg_acr_architecture {
    title 'Agentic Topology: ACG Gateway -> ACR (MCP) -> Lambda / EKS'
    include external_llm, acg_gateway, subgraph_acr, subgraph_acr.*, subgraph_backend, subgraph_backend.*
  }

  dynamic view acg_collision_diorama {
    title 'DIORAMA: 4 Collision Points & Phantom / Uncreated Dependencies'
    external_llm -> acg_gateway '1. LLMs fire concurrent ambiguous queries'
    acg_gateway -> acr_sale_campaign '2. [COLLISION 1] Ambiguity on POR CREAR tool'
    acg_gateway -> acr_made_campaign_dsg '3. Route to campaign design MCP'
    acr_made_campaign_dsg -> lmb_made_campaign_pjc '4. [COLLISION 2] Calls NO EXISTE Lambda -> 502 Bad Gateway'
    acg_gateway -> acr_reward_point_acc '5. [COLLISION 3] Concurrent mutations without lock'
    acr_reward_point_acc -> lmb_acse_reward_acc '6. Double-spend race condition on loyalty balance'
    lmb_coupons_non_expired -> acr_vads_coupons '7. [COLLISION 4] Unpaginated 3MB payload -> Context Window Bloat'
  }

  view view_dom_1 of dom_1 {
    title 'SD-01: CURRENT ACCOUNT Components'
    include dom_1.*
    include eventbridge_bus
  }

  view view_dom_2 of dom_2 {
    title 'SD-02: PAYMENT EXECUTION Components'
    include dom_2.*
    include eventbridge_bus
  }

  view view_dom_3 of dom_3 {
    title 'SD-03: PARTY ROUTING PROFILE Components'
    include dom_3.*
    include eventbridge_bus
  }

  view view_dom_4 of dom_4 {
    title 'SD-04: CUSTOMER OFFER & ONBOARDING Components'
    include dom_4.*
    include eventbridge_bus
  }

  view view_dom_5 of dom_5 {
    title 'SD-05: CUSTOMER AGREEMENT & CONTRACT Components'
    include dom_5.*
    include eventbridge_bus
  }

  view view_dom_6 of dom_6 {
    title 'SD-06: POSITION KEEPING & BALANCES Components'
    include dom_6.*
    include eventbridge_bus
  }

  view view_dom_7 of dom_7 {
    title 'SD-07: FINANCIAL ACCOUNTING & GENERAL LEDGER Components'
    include dom_7.*
    include eventbridge_bus
  }

  view view_dom_8 of dom_8 {
    title 'SD-08: COLLATERAL ALLOCATION & GUARANTEES Components'
    include dom_8.*
    include eventbridge_bus
  }

  view view_dom_9 of dom_9 {
    title 'SD-09: FRAUD DETECTION & RISK SCORING Components'
    include dom_9.*
    include eventbridge_bus
  }

  view view_dom_10 of dom_10 {
    title 'SD-10: CUSTOMER ALERT & NOTIFICATION Components'
    include dom_10.*
    include eventbridge_bus
  }

  view view_dom_11 of dom_11 {
    title 'SD-11: AUDIT, LOGGING & REGULATORY COMPLIANCE Components'
    include dom_11.*
    include eventbridge_bus
  }

  dynamic view flow_02_instant_p2p {
    title 'FLOW-02: Outbound Instant P2P Transfer'
    dom_2.cmd_payment_execution_initiate -> dom_3.qry_party_routing_resolve '1. Resolve phone to CCI'
    dom_2.cmd_payment_execution_initiate -> dom_9.cmd_fraud_detection_evaluate_tx '2. Realtime fraud risk score'
    dom_2.cmd_payment_execution_initiate -> dom_2.sfn_payment_instant_transfer_saga '3. Start transfer saga'
    dom_2.sfn_payment_instant_transfer_saga -> dom_6.cmd_position_keeping_reserve '4. Hold source balance'
    dom_2.sfn_payment_instant_transfer_saga -> dom_3.plug_directory_federation_bridge '5. Dispatch instant rail'
    dom_2.sfn_payment_instant_transfer_saga -> dom_6.cmd_position_keeping_release '6. Release hold & commit debit'
    dom_2.sfn_payment_instant_transfer_saga -> eventbridge_bus '7. Emit PaymentCompletedEvent'
    eventbridge_bus -> dom_10.cmd_customer_alert_dispatch '8. Dispatch push notification'
  }

  dynamic view flow_01_digital_onboarding {
    title 'FLOW-01: Direct Digital Account Opening & KYC'
    dom_4.cmd_customer_onboarding_initiate -> dom_4.sfn_customer_onboarding_saga '1. Initiate onboarding saga'
    dom_4.sfn_customer_onboarding_saga -> dom_4.plug_reniec_biometrics_gateway '2. Validate RENIEC biometrics'
    dom_4.sfn_customer_onboarding_saga -> dom_5.cmd_customer_agreement_sign '3. Sign legal contract'
    dom_4.sfn_customer_onboarding_saga -> dom_1.cmd_current_account_lifecycle '4. Activate Current Account'
    dom_1.cmd_current_account_lifecycle -> eventbridge_bus '5. Emit AccountOpenedEvent'
    eventbridge_bus -> dom_10.cmd_customer_alert_dispatch '6. Welcome SMS alert'
  }
}
