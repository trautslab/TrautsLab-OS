  dom_11 = domain 'SD-11: AUDIT, LOGGING & REGULATORY COMPLIANCE' {
    #bian
    description 'Immutable audit trails, AML (Anti-Money Laundering) transaction tracking, regulatory reporting (SBS/UIF), and compliance alarms.'

    store_db_11 = datastore 'AUDIT, LOGGING & REGULATORY COMPLIANCE Storage' {
      #aws
      description 'Persistence and cache views for AUDIT, LOGGING & REGULATORY COMPLIANCE'
