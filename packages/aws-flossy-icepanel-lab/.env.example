# AWS Flossy (Floci) Local Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
FLOCI_ENDPOINT=http://localhost:4566
EMULATOR_IMAGE=floci/floci:latest

# IcePanel MCP & Cloud API Integration
# Optional: Provide API Key and Landscape ID to synchronize directly with IcePanel Cloud
ICEPANEL_API_KEY=
ICEPANEL_LANDSCAPE_ID=
ICEPANEL_OFFLINE_LANDSCAPE_PATH=artifacts/icepanel-landscape-c4.json

